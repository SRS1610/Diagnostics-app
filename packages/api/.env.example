# packages/api/.env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/diagnostics_dev"

# Auth
JWT_SECRET="generate-a-real-random-secret-min-32-chars"

# Server
PORT=4000

# This API's own externally-reachable base URL — used to build the
# redirect_uri sent to an SSO identity provider (sso.ts). Must match
# whatever the IdP's app registration has on file.
API_BASE_URL=http://localhost:4000

# The portal's base URL — where a browser is sent after an SSO callback
# completes (sso.ts's /auth/sso/callback). Point this at the portal's
# PREVIEW build (npm run preview, default port 4173) when running the
# portal's e2e suite, not the dev server's default 5173.
PORTAL_BASE_URL=http://localhost:5173

# ============================================================
# External services — see CLAUDE.md for which modules need these.
# Leave blank during Sprint 1-6; fill in during Sprint 7-8.
# ============================================================

# Device verification (deviceVerification.ts) — GSMA Device Check or CellDe
DEVICE_VERIFICATION_API_BASE=

# Billing (invoicing.ts) — Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications (notifications.ts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# Shipping (shippingLogistics.ts)
SHIPPING_PROVIDER_API_BASE=
EASYPOST_API_KEY=

# KYC (kycVerification.ts)
PERSONA_API_KEY=

# Activity log query API base (adminActivityLog.ts's queryActivityLog)
ACTIVITY_LOG_API_BASE=http://localhost:4000/activity-log

# Portal auth API base (portalAuth.ts)
PORTAL_AUTH_API_BASE=http://localhost:4000/auth

# License API base (licensing.ts)
LICENSE_API_BASE=http://localhost:4000/licenses

# Profile API base (customerProfile.ts)
PROFILE_API_BASE=http://localhost:4000/profiles

# Technician auth API base (technicianAuth.ts)
TECHNICIAN_AUTH_API_BASE=http://localhost:4000/technicians
