// packages/api/prisma/schema.prisma
//
// Generated from the type definitions in packages/shared/src — this is
// Sprint 1's primary deliverable per the project roadmap. Field names
// and relationships mirror tenant.ts, customerProfile.ts, licensing.ts,
// portalAuth.ts, technicianAuth.ts, adminActivityLog.ts, and types.ts
// exactly, so the API layer can pass Prisma results straight through as
// the TypeScript interfaces already defined.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenant — the top-level entity (tenant.ts)
// ============================================================
model Tenant {
  tenantId            String   @id @default(cuid())
  companyName         String
  status              String   @default("trial") // active | suspended | trial
  primaryContactEmail String
  createdAt           DateTime @default(now())

  profiles     CustomerProfile[]
  licenses     License[]
  portalUsers  PortalUser[]
  technicians  Technician[]
  reports      Report[]
  activityLog  ActivityLogEntry[]
  marketPrices MarketPriceEntry[]
  quotes       TradeInQuote[]
  batches      BatchSession[]

  @@map("tenants")
}

// ============================================================
// CustomerProfile — belongs WITHIN a tenant (customerProfile.ts)
// A tenant can have multiple profiles (different programs/locations)
// ============================================================
model CustomerProfile {
  profileId      String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [tenantId])
  customerName   String
  pin            String // unique WITHIN tenant, not globally — see @@unique below
  enabledTestIds String[] // Postgres text array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reports Report[]

  @@unique([tenantId, pin]) // PIN uniqueness is per-tenant, not global
  @@map("customer_profiles")
}

// ============================================================
// License — bills at the TENANT level (licensing.ts)
// ============================================================
model License {
  licenseId                String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [tenantId])
  type                     String // per_inspection | seat_subscription | tiered_subscription | enterprise_unlimited
  status                   String   @default("active") // active | expired | suspended | quota_exceeded
  billingPeriodStart       DateTime
  billingPeriodEnd         DateTime
  includedQuota            Int?
  usageThisPeriod          Int      @default(0)
  overageRatePerInspection Float?
  seatLimit                Int?
  activeSeats              Int      @default(0)

  invoices Invoice[]

  @@map("licenses")
}

model Invoice {
  invoiceId          String   @id @default(cuid())
  licenseId          String
  license            License  @relation(fields: [licenseId], references: [licenseId])
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  lineItems          Json // InvoiceLineItem[] from invoicing.ts
  subtotal           Float
  total              Float
  status             String   @default("draft") // draft | sent | paid | overdue | void
  issuedAt           DateTime @default(now())
  dueAt              DateTime

  @@map("invoices")
}

// ============================================================
// PortalUser + PortalSession auth (portalAuth.ts)
// ============================================================
model PortalUser {
  userId       String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // master_admin | tenant_admin | tenant_staff
  tenantId     String? // null ONLY for master_admin
  // Restrict, because null here MEANS master_admin. Under the Prisma
  // default (SetNull), deleting a tenant would blank this on its
  // tenant_admins and tenant_staff, silently converting scoped users
  // into unscoped ones whose stored shape contradicts their role.
  tenant       Tenant?  @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@map("portal_users")
}

// ============================================================
// Technician (technicianAuth.ts) — separate identity from PortalUser;
// this is mobile-app shift login, not portal access
// ============================================================
model Technician {
  technicianId String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [tenantId])
  displayName  String
  badgeCode    String
  // How access is revoked now that deleting is refused for anyone who
  // has inspected a device. Someone who leaves, or whose badge is lost,
  // is deactivated: their sessions stop working immediately and their
  // badge no longer logs in, while every report they produced keeps
  // their name on it. Deleting a technician remains possible only while
  // they have no reports at all.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  reports Report[]

  @@unique([tenantId, badgeCode])
  @@map("technicians")
}

// ============================================================
// Report (types.ts AuditReport) + revisions (testSession.ts)
// ============================================================
model Report {
  reportId      String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [tenantId])
  profileId     String?
  // Restrict, NOT the Prisma default. The default referential action for
  // an optional relation is SetNull, which meant deleting a profile or a
  // technician silently blanked that field on every report they were
  // ever attached to — destroying attribution the retention policy says
  // is kept forever, and that QA metrics, redo history and dispute notes
  // are all derived from. The delete succeeded with a 204 and the
  // history was simply gone. A report's provenance is now immutable at
  // the database level: config rows referenced by inspections cannot be
  // deleted at all (deactivate the technician instead).
  profile       CustomerProfile? @relation(fields: [profileId], references: [profileId], onDelete: Restrict)
  technicianId  String?
  technician    Technician?      @relation(fields: [technicianId], references: [technicianId], onDelete: Restrict)
  generatedAt   DateTime         @default(now())
  deviceMake    String
  deviceModel   String
  serialNumber  String
  imei          String
  imei2         String?
  captureSource String // barcode | ocr | manual
  results       Json // DiagnosticResult[]
  overallStatus String // pass | fail | pass_with_warnings
  routing       String? // resale | repair | parts_harvest | recycle | hold_ineligible

  // Capability token for the consumer-facing tracker and the QR-linked
  // public summary. Unauthenticated callers reach exactly one report
  // through this and nothing else — it is the ONLY way a request with no
  // portal or technician session can read anything, so it must be
  // unguessable (32 random bytes) rather than derived from the reportId.
  // The token identifies the tenant too, which is why no public route
  // ever accepts a tenantId from the caller.
  consumerToken String @unique

  // A consumer who declines their offer. Distinct from "no quote yet"
  // and from an expired quote, because those need different next steps
  // and a tracker that conflates them tells the customer nothing.
  offerDeclinedAt DateTime?

  revisions       ReportRevision[]
  wipeCertificate DataWipeCertificate?
  warrantyClaims  WarrantyClaim[]
  quote           TradeInQuote?
  listing         MarketplaceListing?

  @@index([tenantId, serialNumber]) // Devices tab groups by serial, within tenant
  @@map("reports")
}

model ReportRevision {
  id                    String   @id @default(cuid())
  reportId              String
  report                Report   @relation(fields: [reportId], references: [reportId])
  revisionNumber        Int
  revisedAt             DateTime @default(now())
  revisedByTechnicianId String
  testIdsRedone         String[]
  reason                String?

  // Revision numbers must be unique and gapless per report — they are
  // rendered as DDA-0217-R1, -R2 and referenced by testSession.ts. A
  // count-then-insert cannot guarantee that under READ COMMITTED, so the
  // database enforces it rather than the application hoping.
  @@unique([reportId, revisionNumber])
  @@map("report_revisions")
}

model DataWipeCertificate {
  certificateId          String   @id @default(cuid())
  reportId               String   @unique
  report                 Report   @relation(fields: [reportId], references: [reportId])
  deviceSerial           String
  imei                   String
  standard               String // nist_800_88_clear | nist_800_88_purge
  wipedAt                DateTime @default(now())
  verifiedByTechnicianId String
  passed                 Boolean

  @@map("data_wipe_certificates")
}

model WarrantyClaim {
  claimId           String   @id @default(cuid())
  reportId          String
  report            Report   @relation(fields: [reportId], references: [reportId])
  deviceSerial      String
  claimedIssue      String
  submittedAt       DateTime @default(now())
  warrantyExpiresAt DateTime
  status            String   @default("open") // open | investigating | approved | denied | resolved
  resolutionNotes   String?

  @@map("warranty_claims")
}

// ============================================================
// Admin Activity Log (adminActivityLog.ts) — central audit trail
// ============================================================
model ActivityLogEntry {
  entryId     String   @id @default(cuid())
  tenantId    String? // null for platform-level actions
  // Restrict. Null here means "platform-level action", so the Prisma
  // default (SetNull) would not merely orphan a deleted tenant's audit
  // rows — it would RELABEL them as master-admin platform actions,
  // which is worse than losing them. An audit trail that can be
  // rewritten by deleting a row elsewhere is not one.
  tenant      Tenant?  @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  actorUserId String
  actorRole   String // master_admin | tenant_admin | tenant_staff | technician | system
  // "technician" means actorUserId is a Technician, not a PortalUser
  action      String
  targetType  String
  targetId    String
  details     String?
  metadata    Json?
  timestamp   DateTime @default(now())
  ipAddress   String?

  @@index([tenantId, timestamp])
  @@map("activity_log")
}

// ============================================================
// Dispute (admin_portal_disputes.html backend — not yet wired to a
// TypeScript module; flagged in CLAUDE.md as a real gap)
// ============================================================
model Dispute {
  disputeId        String    @id @default(cuid())
  tenantId         String
  reportId         String
  disputingItem    String // which test/grade is disputed
  customerNote     String
  status           String    @default("awaiting_review") // awaiting_review | resolved_upheld | resolved_adjusted
  resolvedByUserId String?
  resolutionNotes  String?
  submittedAt      DateTime  @default(now())
  resolvedAt       DateTime?

  @@map("disputes")
}

// ============================================================
// Trade-in valuation (tradeInQuote.ts)
// ============================================================

// Per-tenant, because each customer maintains their own pricing —
// CLAUDE.md's Excel upload exists so admins can keep prices current
// without a code change. NOTE: the seed data shipped in
// marketPriceData.ts is explicitly rough/illustrative; a quote computed
// from it is not a real offer. See marketPriceSource on TradeInQuote.
model MarketPriceEntry {
  priceId         String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [tenantId])
  model           String
  storageGb       Int
  // CosmeticGrade -> base price in USD, before deductions.
  gradeBasePrices Json
  currency        String   @default("USD")
  updatedAt       DateTime @updatedAt

  // One price row per model+storage per tenant, so a quote lookup can
  // never be ambiguous the way the licence lookup once was.
  @@unique([tenantId, model, storageGb])
  @@map("market_prices")
}

model TradeInQuote {
  quoteId     String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [tenantId])
  reportId    String    @unique
  report      Report    @relation(fields: [reportId], references: [reportId])
  deviceModel String
  grade       String
  basePrice   Float
  deductions  Json
  finalOffer  Float
  currency    String    @default("USD")
  quotedAt    DateTime  @default(now())
  // CLAUDE.md: "Quotes expire (7-day default) — prices move; don't let a
  // quote sit open-ended."
  expiresAt   DateTime
  // Whether the price table behind this quote was real data or the
  // illustrative seed. Recorded per quote because it determines whether
  // the number can be shown to a customer at all.
  priceSource String    @default("unverified_seed_data")
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?

  payout PayoutRecord?

  @@map("trade_in_quotes")
}

// CLAUDE.md: payout is "a separate lifecycle from the quote itself — a
// quote can be accepted without payout being complete yet."
model PayoutRecord {
  payoutId      String       @id @default(cuid())
  quoteId       String       @unique
  quote         TradeInQuote @relation(fields: [quoteId], references: [quoteId])
  method        String // store_credit | ach | paypal | gift_card
  status        String       @default("pending") // pending | processing | completed | failed
  amount        Float
  initiatedAt   DateTime     @default(now())
  completedAt   DateTime?
  reference     String?
  failureReason String?

  @@map("payout_records")
}

// ============================================================
// Marketplace listing (marketplaceListing.ts)
// ============================================================
model MarketplaceListing {
  listingId   String   @id @default(cuid())
  reportId    String   @unique
  report      Report   @relation(fields: [reportId], references: [reportId])
  title       String
  description String
  askingPrice Float
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  @@map("marketplace_listings")
}

// ============================================================
// Bulk batch intake (batchSession.ts)
// ============================================================
model BatchSession {
  batchId       String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId])
  sourceName    String
  profileId     String?
  technicianId  String?
  // Serials scanned into this lot. CLAUDE.md: re-scanning the same
  // serial is a no-op, not a duplicate entry.
  deviceSerials String[]
  status        String    @default("open") // open | closed
  createdAt     DateTime  @default(now())
  closedAt      DateTime?

  @@map("batch_sessions")
}
