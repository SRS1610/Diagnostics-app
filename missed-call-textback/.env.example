# --- required ---
DATABASE_URL=postgresql://textback:textback_dev@localhost:5432/textback_dev
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Public HTTPS origin Twilio can reach (ngrok URL in dev). Signatures are
# verified against this, so it must match exactly what Twilio calls.
PUBLIC_BASE_URL=http://localhost:4000

# --- Twilio (without these the app runs in demo mode: texts are logged, not sent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A2P 10DLC-registered Messaging Service. Strongly recommended for US traffic.
TWILIO_MESSAGING_SERVICE_SID=
# Only ever false for local curl testing.
TWILIO_VALIDATE_SIGNATURES=true

# --- optional: weekly digest by email ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

PORT=4000
RUN_WORKER=true
WORKER_INTERVAL_MS=30000
