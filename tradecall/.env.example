# --- required ---
DATABASE_URL=postgresql://textback:textback_dev@localhost:5432/tradecall_dev
JWT_SECRET=                       # openssl rand -hex 32
PUBLIC_URL=http://localhost:4100  # what owners open; used in alert-text links

# --- Telnyx (all three needed; otherwise the app runs in demo mode) ---
TELNYX_API_KEY=                   # Mission Control → Auth → API Keys (V2)
TELNYX_PUBLIC_KEY=                # Mission Control → Keys & Credentials → Public Key (base64)
TELNYX_CONNECTION_ID=             # your Call Control Application's id
TELNYX_MESSAGING_PROFILE_ID=      # 10DLC-registered messaging profile (strongly recommended)

# --- optional: weekly digest by email (Resend) ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL=                # e.g. TradeCall <digest@yourdomain.com> — domain verified in Resend

PORT=4100
RUN_WORKER=true
WORKER_INTERVAL_MS=30000
