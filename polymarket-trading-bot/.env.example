# Copy to .env and fill in. Never commit the real .env file.

# --- Mode ---
# true = compute signals and log intended orders, never submit anything.
# Start here. Only flip to false once you've backtested and reviewed the
# risk limits below.
DRY_RUN=true

# --- Polymarket CLOB credentials (only required when DRY_RUN=false) ---
# Polygon wallet private key used to sign orders. Fund this wallet with only
# what you are willing to lose to a bot bug. Never commit this value.
PRIVATE_KEY=
# L2 API credentials from py-clob-client's create_or_derive_api_creds()
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# --- Markets to trade (comma-separated Polymarket condition IDs) ---
MARKET_CONDITION_IDS=

# --- Strategy parameters ---
LOOKBACK_TICKS=30
Z_SCORE_ENTRY=2.0
Z_SCORE_EXIT=0.5
POLL_INTERVAL_SEC=15

# --- Risk limits (USD) ---
MAX_POSITION_USD=500
PER_MARKET_MAX_USD=100
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_USD=100
KELLY_FRACTION=0.25
MAX_SLIPPAGE_CENTS=2
